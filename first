-- CREATE OR UPDATE ONE PLAYER
local function updatePlayerESP(targetPlayer)
    if not espEnabled or destroyed then
        return
    end

    if targetPlayer == player then
        return
    end

    local character = targetPlayer.Character
    if not character then
        removePlayerESP(targetPlayer)
        return
    end

    local humanoidTarget = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoidTarget or not root then
        return
    end

    local record = espObjects[targetPlayer]

    if record and record.character ~= character then
        removePlayerESP(targetPlayer)
        record = nil
    end

    if not record then
        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerESPHighlight"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.88
        highlight.OutlineTransparency = 0
        highlight.Parent = getESPFolder(targetPlayer) or character

        local billboard, stroke, nameLabel, toolScroll =
            createToolInventoryBillboard(targetPlayer, character)

        if not billboard then
            highlight:Destroy()
            return
        end

        record = {
            character = character,
            highlight = highlight,
            billboard = billboard,
            stroke = stroke,
            nameLabel = nameLabel,
            toolScroll = toolScroll,
            lastToolRefresh = 0
        }

        espObjects[targetPlayer] = record
    end

    local colour = getPlayerESPColour(targetPlayer)

    record.highlight.FillColor = colour
    record.highlight.OutlineColor = colour

    if record.stroke then
        record.stroke.Color = colour
    end

    if record.nameLabel then
        record.nameLabel.TextColor3 = colour
        record.nameLabel.Text =
            targetPlayer.DisplayName .. " (@" .. targetPlayer.Name .. ")"
    end

    local now = os.clock()

    if now - record.lastToolRefresh >= 0.75 then
        record.lastToolRefresh = now
        refreshPlayerTools(targetPlayer, record)
    end
end

