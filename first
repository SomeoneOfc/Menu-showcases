-- fires it, allowing the old copy to run the very same full cleanup used by
-- DESTROY ALL (connections, character changes, overlays, GUI and script).
-- Pressing G is different: G STILL only moves the current GUI off-screen.
local trackedServiceConnections = {}
local extraCleanup = {}
local function trackServiceConnection(connection)
    if connection then table.insert(trackedServiceConnections, connection) end
    return connection
end
local function registerCleanup(callback)
