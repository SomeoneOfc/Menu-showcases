        local p = root.Position
        coordinates.Text = string.format("%.2f, %.2f, %.2f", p.X, p.Y, p.Z)
        coordinates:CaptureFocus()
        utilityStatus.Text = "Coordinates selected. Use Ctrl + A then Ctrl + C to copy."
    end)

    -- One throttled update loop for BOTH the Toolkit card and optional HUD.
    local acc = 0
    local avgFps = 60
    local statsConnection = trackServiceConnection(RunService.RenderStepped:Connect(function(dt)
        if destroyed then return end
        if dt > 0 then avgFps = avgFps * 0.88 + math.min(240, 1 / dt) * 0.12 end
        acc += dt
        if acc < 0.45 then return end
        acc = 0
        if not toolkitPage.Visible and not showHud then return end
        local p, speed = nil, 0
        local root = getRoot()
        if root then
            p = root.Position
            speed = root.AssemblyLinearVelocity.Magnitude
        end
        local ping = "--"
        pcall(function()
            ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
        end)
        local fpsText = tostring(math.floor(avgFps + 0.5))
        local speedText = tostring(math.floor(speed + 0.5))
        fpsValue.Text = fpsText .. " FPS" -- measured FPS, not the selected (unapplied) preference
        pingValue.Text = tostring(ping)
        speedValue.Text = speedText .. " STUD/S"
        local xyz = p and string.format("%.0f, %.0f, %.0f", p.X, p.Y, p.Z) or "--, --, --"
        positionValue.Text = "Position   " .. xyz
        hudContent.Text = fpsText .. " FPS   ·   " .. speedText .. " stud/s\n" .. (detailedHud and ("Ping: " .. tostring(ping) .. "   |   XYZ: " .. xyz) or ("XYZ: " .. xyz))
    end))
