    local homeToolkitButton = action(homePage, "HomeToolkitShortcut", "OPEN TOOLKIT   →", UDim2.fromOffset(20, 530), UDim2.new(0.5, -27, 0, 39), true)
    homeToolkitButton.Activated:Connect(function() showPage(toolkitPage) end)
    local homeSearchButton = action(homePage, "HomeSearchShortcut", "FIND COMMAND   ↗", UDim2.new(0.5, 8, 0, 530), UDim2.new(0.5, -28, 0, 39), false)
    homeSearchButton.Activated:Connect(openPalette)

    trackServiceConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if destroyed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if keyCaptureTarget then return end
        if paletteShade.Visible and input.KeyCode == Enum.KeyCode.Escape then
            closePalette()
            return
        end
        local ctrlDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        if commandSearchKey and input.KeyCode == commandSearchKey and ctrlDown
            and os.clock() - lastKeyCaptureAt >= 0.08 then
            if paletteShade.Visible then closePalette() else openPalette() end
            return
        end
        if processed or paletteShade.Visible then return end
        local altDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
            or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)
        if pageNavigationEnabled and altDown and menuOpen
            and os.clock() - lastKeyCaptureAt >= 0.08 then
            local index = ({[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2,
                [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4,
                [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
                [Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8,
                [Enum.KeyCode.Nine] = 9})[input.KeyCode]
            local pages = {homePage, movementPage, finderPage,
                content:FindFirstChild("OptionsPage"), content:FindFirstChild("WaypointsPage"),
                content:FindFirstChild("ConsolePage"), content:FindFirstChild("BSSPage"),
                content:FindFirstChild("FunPage"), toolkitPage}
            if index and pages[index] then showPage(pages[index]) end
        end
    end))

    -- Retain the same GUI; don't create another page or menu when reopened.
    showPage(homePage)
    if refreshOptionsLabels then refreshOptionsLabels() end
    print("[ErrorB1478Menu] Studio edition ready: Toolkit, command search and refined layout created once.")
end)

