destroyEverything = function()
    if destroyed then return end
    destroyed = true -- guard against every delayed callback and all keybinds immediately
    menuOpen = false
    stopMenuMotion()

    -- Stop gameplay changes and remove all overlays before destroying the root GUI.
    pcall(function() stopFly() end)
    pcall(function() setNoclip(false) end)
    infiniteJump = false
    pcall(function() setPlayerEspEnabled(false) end)
    for _, cleanup in ipairs(extraCleanup) do
        local ok, err = pcall(cleanup)
        if not ok then warn("[ErrorB1478Menu] Cleanup issue: " .. tostring(err)) end
    end
    pcall(restoreCharacter)
    pcall(function() setErrorMonitorEnabled(false) end)

    -- Disconnect every event listener created by the menu, even those attached
    -- to Roblox services rather than GUI objects.
    for _, connection in ipairs(trackedServiceConnections) do
        pcall(function() connection:Disconnect() end)
    end
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    if noclipDescendantConnection then pcall(function() noclipDescendantConnection:Disconnect() end) end
    if noclipEnforceConnection then pcall(function() noclipEnforceConnection:Disconnect() end) end
    table.clear(trackedServiceConnections)
    table.clear(connections)
    table.clear(extraCleanup)

    if errorMonitorGui then pcall(function() errorMonitorGui:Destroy() end) end
    if gui then pcall(function() gui:Destroy() end) end
    -- The old LocalScript is removed last. Its G key can no longer reopen
    -- the GUI. A separately launched NEW copy may deliberately build a fresh one.
    print("[ErrorB1478Menu] DESTROY ALL completed; old menu and owned effects removed.")
    pcall(function() script:Destroy() end)
