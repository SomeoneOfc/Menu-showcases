--==================================================
-- FLY
--==================================================

local function startFly()
    if destroyed or flying then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    flying = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "MenuFlyVelocity"
    bodyVelocity.MaxForce =
        Vector3.new(100000, 100000, 100000)
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = root

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "MenuFlyGyro"
    bodyGyro.MaxTorque =
        Vector3.new(100000, 100000, 100000)
    bodyGyro.P = 10000
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root

    local h = getHumanoid()

    if h then
        h.AutoRotate = false
    end

    setFlyButtonState()
end

local function stopFly()
    flying = false

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end

    local h = getHumanoid()

    if h then
        h.AutoRotate = true
    end

    setFlyButtonState()
end

--==================================================
-- NOCLIP
--==================================================

local function setNoclip(enabled)
    noclip = enabled

    local character = getCharacter()

    if not character then
        setNoclipButtonState()
        return
    end

    if not enabled then
        for _, object in ipairs(
            character:GetDescendants()
        ) do
            if object:IsA("BasePart") then
                object.CanCollide = true
            end
        end
    end

    setNoclipButtonState()
end

--==================================================
-- REVERT MOVEMENT
--==================================================

local function revertMovement()
    local h = getHumanoid()

    if not h then
        return
    end

    h.WalkSpeed = originalWalkSpeed
    h.UseJumpPower = originalUseJumpPower
    h.JumpPower = originalJumpPower
    h.JumpHeight = originalJumpHeight

    savedWalkSpeed = originalWalkSpeed
    savedJumpPower = originalJumpPower
    savedJumpHeight = originalJumpHeight

    speedBox.Text =
        tostring(originalWalkSpeed)

    if originalUseJumpPower then
        jumpBox.Text =
            tostring(originalJumpPower)
    else
        jumpBox.Text =
            tostring(originalJumpHeight)
    end
end

