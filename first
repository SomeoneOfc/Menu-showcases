        reticleStyle = reticleStyle % 3 + 1
        updateReticle()
        reticleStyleButton.Text = "STYLE   " .. ({"CROSS + DOT", "DOT", "CROSS"})[reticleStyle]
    end)
    hudDetailButton.Activated:Connect(function()
        detailedHud = not detailedHud
        hudDetailButton.Text = "HUD DETAIL   " .. (detailedHud and "EXTENDED" or "BASIC")
    end)
    fovButton.Activated:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        if not changedFov then previousFov = cam.FieldOfView end
        changedFov = true
        selectedFov = selectedFov % #fovOptions + 1
        cam.FieldOfView = fovOptions[selectedFov]
        fovButton.Text = "CAMERA FOV   " .. fovOptions[selectedFov]
