    local destroyRequest = existingMenu:FindFirstChild("ErrorB1478DestroyRequest")
    if destroyRequest and destroyRequest:IsA("BindableEvent") then
        print("[ErrorB1478Menu] New load detected: asking old menu to run DESTROY ALL.")
        destroyRequest:Fire()
        -- BindableEvent callbacks run asynchronously. Do not start a new
        -- menu until the old instance confirms destruction by disappearing.
        local deadline = os.clock() + 3
        while existingMenu.Parent and os.clock() < deadline do
            task.wait(0.03)
        end
    end
    if existingMenu.Parent then
        -- Backwards compatibility for menu builds created before this
        -- replacement protocol existed. Old event listeners cannot always
        -- be force-disconnected from a different LocalScript in normal Studio.
        warn("[ErrorB1478Menu] Legacy/stuck old copy: removing its GUI. Restart Play ONCE when upgrading from an older menu to ensure its old listeners/effects also stop.")
