-- CAPTURE A KEY WHEN A KEYBIND BOX IS SELECTED
table.insert(connections, UserInputService.InputBegan:Connect(
    function(input, gameProcessed)
        if destroyed then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        -- The user is choosing a new key.
        if activeKeybindBox then
            local box = activeKeybindBox
            local featureName = keybindBoxes[box]

            -- G controls the menu, and Y remains the default ESP key.
            -- Keep those keys reserved to avoid conflicting toggles.
            if input.KeyCode == Enum.KeyCode.G then
                box.Text = "Reserved"
                box:ReleaseFocus()
                return
            end

            if input.KeyCode == Enum.KeyCode.Y
                and featureName ~= "ESP" then
                box.Text = "Reserved"
                box:ReleaseFocus()
                return
            end

            setKeybind(featureName, input.KeyCode, box)
            return
        end

        if gameProcessed then
            return
        end

        -- G and Y already have their original handlers in Part 5.
        if input.KeyCode == Enum.KeyCode.G
            or input.KeyCode == Enum.KeyCode.Y then
            return
        end

        -- Toggle the feature assigned to the pressed key.
        for featureName, assignedKey in pairs(keybinds) do
            if assignedKey and input.KeyCode == assignedKey then
                if featureName == "Fly" then
                    if flying then
                        stopFlying()
                    else
                        startFlying()
                    end

                elseif featureName == "Noclip" then
                    setNoclip(not noclip)

                elseif featureName == "InfiniteJump" then
                    infiniteJump = not infiniteJump

                    updateMovementButton(
                        infiniteJumpButton,
                        "Infinite jump",
                        infiniteJump
                    )

                elseif featureName == "ESP" then
                    toggleESP()
                end
            end
        end
    end
))

