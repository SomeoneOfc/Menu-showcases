    table.clear(allFolders)

    selectedFolder = nil

    selectedLabel.Text =
        "Selected: None"

    -- Workspace folders.
    collectFolders(
        workspace,
        "Workspace"
    )

    -- ReplicatedStorage folders.
    collectFolders(
        ReplicatedStorage,
        "ReplicatedStorage"
    )

    table.sort(
        allFolders,
        function(a, b)
            return a.Path < b.Path
        end
    )

    rebuildFolderList()
end

