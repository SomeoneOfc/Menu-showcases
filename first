local function setNoclip(enabled)
    noclip = enabled

    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end
    if noclipEnforceConnection then
        noclipEnforceConnection:Disconnect()
        noclipEnforceConnection = nil
    end

    local character = getCharacter()
    if not character then
        setNoclipButtonState()
        return
    end

    if noclipCharacter ~= character then
        noclipOriginalCanCollide = {}
        noclipCharacter = character
    end

    local function disablePartCollision(object)
        if object:IsA("BasePart") then
            if noclipOriginalCanCollide[object] == nil then
                noclipOriginalCanCollide[object] = object.CanCollide
            end
            object.CanCollide = false
        end
    end

    if enabled then
        for _, object in ipairs(character:GetDescendants()) do
            disablePartCollision(object)
        end

        noclipDescendantConnection = character.DescendantAdded:Connect(function(object)
            if noclip and not destroyed then
                disablePartCollision(object)
            end
        end)

        noclipEnforceConnection = RunService.Stepped:Connect(function()
            if destroyed or not noclip then return end
            local activeCharacter = getCharacter()
            if activeCharacter ~= character then return end
            for _, object in ipairs(character:GetDescendants()) do
                if object:IsA("BasePart") and object.CanCollide then
                    disablePartCollision(object)
                end
            end
        end)
    else
        for object, originalValue in pairs(noclipOriginalCanCollide) do
            if object and object.Parent and object:IsA("BasePart") then
                object.CanCollide = originalValue
            end
        end
        noclipOriginalCanCollide = {}
    end

    setNoclipButtonState()
end

