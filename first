local function clearFinderResults()
    for _, child in ipairs(resultsFrame:GetChildren()) do
        if child ~= resultsLayout and child ~= resultsPadding then
            child:Destroy()
        end
    end

    resultsLabel.Text = "Results: 0"
end

local function getSearchRoots()
    return {
        workspace,
        ReplicatedStorage
    }
end

local function findObjects(searchText)
    local found = {}
    local query = string.lower(searchText)

    if query == "" then
        return found
    end

    for _, root in ipairs(getSearchRoots()) do
        for _, object in ipairs(root:GetDescendants()) do
            if string.find(
                string.lower(object.Name),
                query,
                1,
                true
            ) then
                table.insert(found, object)

                -- Avoid creating an enormous number of result rows.
                if #found >= 100 then
                    return found
                end
            end
        end
    end

    return found
end

local function teleportToObject(object)
    if not object or not object.Parent then
        finderStatus.Text = "That object no longer exists."
        return
    end

    local character = player.Character
    local characterRoot = character
        and character:FindFirstChild("HumanoidRootPart")

    if not characterRoot then
        finderStatus.Text = "Your character is not ready."
        return
    end

    local targetPart = nil

    if object:IsA("BasePart") then
        targetPart = object
    elseif object:IsA("Model") then
        targetPart = object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    else
        targetPart = object:FindFirstAncestorWhichIsA("BasePart")

        if not targetPart then
            local model = object:FindFirstAncestorWhichIsA("Model")

            if model then
                targetPart = model.PrimaryPart
                    or model:FindFirstChildWhichIsA("BasePart", true)
            end
        end
    end

    if not targetPart then
        finderStatus.Text = "No physical part found for that object."
        return
    end

    -- Move the local character slightly above the target.
    characterRoot.CFrame = targetPart.CFrame * CFrame.new(0, 4, 0)
    finderStatus.Text = "Teleported to: " .. object.Name
end

