local function recordClientError(message)
    __EB1478_errorCount += 1
    local line = "#" .. tostring(__EB1478_errorCount) .. ": " .. tostring(message or "Unknown client error")
    table.insert(__EB1478_errorLines, line)
    while #__EB1478_errorLines > 7 do table.remove(__EB1478_errorLines, 1) end
    warn("[ErrorB1478Menu][F9] Client error " .. line)
    if errorMonitorEnabled then
        buildErrorMonitor()
        if errorMonitorText then
            errorMonitorText.Text = table.concat(__EB1478_errorLines, "\n")
        end
    end
end

