        end

        value = math.clamp(
            value,
            0,
            500
        )

        savedWalkSpeed = value

        local h = getHumanoid()

        if h then
            h.WalkSpeed = value
        end

        speedBox.Text =
            tostring(value)
    end
)

setFlySpeedButton.MouseButton1Click:Connect(
    function()
        local value =
            tonumber(flySpeedBox.Text)

        if not value then
            flySpeedBox.Text =
                tostring(currentFlySpeed)
            return
        end

        currentFlySpeed =
            math.clamp(
                value,
                10,
                500
            )

        flySpeedBox.Text =
            tostring(currentFlySpeed)
    end
)

setJumpButton.MouseButton1Click:Connect(
    function()
        local value =
            tonumber(jumpBox.Text)

        if not value then
            return
        end

        local h = getHumanoid()

        if not h then
            return
        end

        value = math.clamp(
            value,
            0,
            500
        )

        if originalUseJumpPower then
            savedJumpPower = value
            h.UseJumpPower = true
            h.JumpPower = value
        else
            savedJumpHeight = value
            h.UseJumpPower = false
            h.JumpHeight = value
        end

        jumpBox.Text =
            tostring(value)
    end
)

resetMovementButton.MouseButton1Click:Connect(
