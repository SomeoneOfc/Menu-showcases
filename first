    local function closePalette()
        paletteShade.Visible = false
        searchBox:ReleaseFocus()
    end
    closeQuickSearch = closePalette
    paletteClose.Activated:Connect(closePalette)
    local function renderMatches()
        for _, child in ipairs(paletteList:GetChildren()) do child:Destroy() end
        local query = string.lower(searchBox.Text):gsub("^%s+", ""):gsub("%s+$", "")
        local count = 0
        for _, cmd in ipairs(commands) do
            local haystack = string.lower(cmd[1] .. " " .. cmd[2] .. " " .. cmd[4])
            if query == "" or string.find(haystack, query, 1, true) then
                count += 1
                if count > 6 then break end
                local btn = action(paletteList, "Result" .. count, cmd[1], UDim2.fromOffset(0, (count - 1) * 50), UDim2.new(1, 0, 0, 44), false)
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Text = "  " .. cmd[1] .. "     /     " .. cmd[2]
                btn.TextSize = 11
                btn.ZIndex = 104
                btn.Activated:Connect(function()
                    closePalette()
                    if destroyed then return end
                    local ok, err = pcall(cmd[3])
                    if not ok then warn("[ErrorB1478Menu][COMMAND] " .. tostring(err)) end
                end)
            end
        end
        if count == 0 then
            local empty = label(paletteList, "Empty", "No commands found. Try another search.", UDim2.fromOffset(6, 6), UDim2.new(1, -12, 0, 35), 12, COLORS.muted)
            empty.ZIndex = 104
        end
    end
    searchBox:GetPropertyChangedSignal("Text"):Connect(renderMatches)
    local function openPalette()
        if destroyed then return end
        if not menuOpen then setMenuVisible(true) end
        paletteShade.Visible = true
        searchBox.Text = ""
        renderMatches()
        searchBox:CaptureFocus()
    end
