-- PERMANENT SHUTDOWN
local function panic()
    if destroyed then
        return
    end

    destroyed = true
    menuOpen = false

    -- Stop movement features.
    flying = false
    noclip = false
    infiniteJump = false

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end

    local characterHumanoid = getHumanoid()

    if characterHumanoid then
        characterHumanoid.PlatformStand = false
        characterHumanoid.WalkSpeed = originalWalkSpeed
        characterHumanoid.UseJumpPower = originalUseJumpPower
        characterHumanoid.JumpPower = originalJumpPower
        characterHumanoid.JumpHeight = originalJumpHeight
    end

    -- Restore collision on this character.
    local character = getCharacter()

    if character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = true
            end
        end
    end

    -- Remove ESP.
    disableESP()

    -- Disconnect registered background connections.
    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    for _, connection in ipairs(espConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)
    table.clear(espConnections)

    -- Destroy the interface and this LocalScript.
    gui:Destroy()
    script:Destroy()
end

