-- Do not use loadstring/HttpGet in a normal Studio LocalScript.
-- Error Monitor is optional and OFF by default; F9 diagnostics remain available. G moves the same GUI right, around the bottom outside the screen, and parks it left for reopening.
-- This prevents an add-on runtime error from stopping the core menu, but it cannot
-- guarantee all features work without running in the target Roblox experience.

-- SELF-DIAGNOSTIC BUILD NOTES:
-- Adds section context, ScriptContext error reports, startup checks, an optional Error Monitor (OFF by default), and animated menu slide transitions.
-- NIL-GUARD AUDIT NOTES:
-- Optional character parts, humanoids, cameras, user IDs, and tool textures are checked
-- before use where needed. Some variables intentionally start as nil until a feature is
-- activated (for example bodyVelocity, bodyGyro, and connection handles).
-- Run this as a LocalScript in StarterPlayer > StarterPlayerScripts.
-- Do not wrap this file in loadstring(game:HttpGet(...))() in ordinary Roblox Studio;
-- install it directly as a LocalScript instead.

--==================================================
-- SELF-DIAGNOSTICS / SAFE-LOAD SUPPORT
--==================================================
local __EB1478_entryOk, __EB1478_entryError = xpcall(function()
local __EB1478_currentSection = "Startup"
local __EB1478_loadedSections = {}
local __EB1478_failedSections = {}
local __EB1478_seenErrors = {}

local function __EB1478_markSection(name)
    __EB1478_currentSection = tostring(name or "Unknown section")
    __EB1478_loadedSections[__EB1478_currentSection] = "running"
end

local function __EB1478_markSectionLoaded(name)
    name = tostring(name or __EB1478_currentSection)
    __EB1478_loadedSections[name] = "loaded"
end

local function __EB1478_safeCall(sectionName, callback, ...)
    sectionName = tostring(sectionName or "Unknown section")
    __EB1478_markSection(sectionName)
    if type(callback) ~= "function" then
        local msg = "[ErrorB1478Menu][SAFE-LOAD] " .. sectionName .. " skipped: callback is not a function."
        warn(msg)
        __EB1478_failedSections[sectionName] = msg
        __EB1478_loadedSections[sectionName] = "failed"
        return false, msg
    end
    local args = table.pack(...)
    local ok, result = xpcall(function()
        return callback(table.unpack(args, 1, args.n))
    end, debug.traceback)
    if not ok then
        local msg = "[ErrorB1478Menu][SAFE-LOAD] " .. sectionName .. " FAILED; other protected sections will continue:\n" .. tostring(result)
        warn(msg)
        __EB1478_failedSections[sectionName] = msg
        __EB1478_loadedSections[sectionName] = "failed"
        return false, result
    end
    __EB1478_loadedSections[sectionName] = "loaded"
    print("[ErrorB1478Menu][SAFE-LOAD] " .. sectionName .. " loaded.")
    return true, result
end

