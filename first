local menuToggleKey = Enum.KeyCode.G
local flyToggleKey = Enum.KeyCode.F
local noclipToggleKey = Enum.KeyCode.N
local jumpToggleKey = Enum.KeyCode.J
local espToggleKey = Enum.KeyCode.Y
local positionSaveKey = Enum.KeyCode.P -- Optional; reopening always returns to centre anyway.
local teleportHoldKey = Enum.KeyCode.T -- Hold T and left-click the game world (not UI).
local destroyAllKey = Enum.KeyCode.BackSlash -- Press \ to use the same DESTROY ALL action as the button.
local mouseLockKey = Enum.KeyCode.Quote -- Press apostrophe (') to toggle mouse lock.
local monochromeKey = nil -- Set a key in Options or use the on-screen toggle.
local destroyEverything = nil -- Declared early: button and keyboard call the same function.
local toggleMouseLock = nil
local toggleMonochromeHighlights = nil
local commandSearchKey = Enum.KeyCode.K -- Ctrl + chosen key; optional.
local pageNavigationEnabled = true -- Alt + number; can be disabled entirely.
local lastKeyCaptureAt = -math.huge
local keyCaptureStatusCallback = nil
local teleportStatusCallback = nil
local keyCaptureTarget = nil
local refreshOptionsLabels = nil
local positionSaveStatusCallback = nil
local floatingToggleEnabled = true
local floatingToggleButton = nil

local TweenService = game:GetService("TweenService")
local savedMenuPosition = UDim2.fromScale(0.5, 0.5) -- Always return to screen centre when shown.
local menuTween = nil
local menuTransitionId = 0
local menuSlideDuration = 0.20
local menuAroundDuration = 0.14 -- The remaining travel happens entirely OFF SCREEN.

-- Keep the ORIGINAL instances alive at all times. Closing only changes Position.
main.AnchorPoint = Vector2.new(0.5, 0.5)
main.Position = savedMenuPosition
main.Visible = true
gui.Enabled = true

local function getMenuViewportSize()
    local camera = workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

local function getMenuOffscreenRightPosition()
    local viewport = getMenuViewportSize()
    return UDim2.new(0, viewport.X + math.ceil(main.AbsoluteSize.X / 2) + 48,
        savedMenuPosition.Y.Scale, savedMenuPosition.Y.Offset)
end

local function getMenuOffscreenLeftPosition()
    return UDim2.new(0, -math.ceil(main.AbsoluteSize.X / 2) - 48,
        savedMenuPosition.Y.Scale, savedMenuPosition.Y.Offset)
end

local function getMenuOffscreenBottomPosition(xPosition)
    local viewport = getMenuViewportSize()
    return UDim2.new(0, xPosition.X.Offset, 0,
        viewport.Y + math.ceil(main.AbsoluteSize.Y / 2) + 48)
end

local function stopMenuMotion()
    menuTransitionId += 1
    if menuTween then
        local previousTween = menuTween
        menuTween = nil
        pcall(function() previousTween:Cancel() end)
    end
    return menuTransitionId
end

local function moveMenuTo(targetPosition, duration, easingDirection, token, whenDone)
    if token ~= menuTransitionId or destroyed or not main.Parent then return end
    local tween = TweenService:Create(main,
        TweenInfo.new(duration, Enum.EasingStyle.Quint, easingDirection),
        {Position = targetPosition})
    menuTween = tween
    tween.Completed:Connect(function(playbackState)
        if token ~= menuTransitionId then return end
        menuTween = nil
        if playbackState ~= Enum.PlaybackState.Completed then return end
        main.Position = targetPosition
        if whenDone then whenDone() end
    end)
    tween:Play()
end

setMenuVisible = function(visible)
    if destroyed then return end
    -- Never construct or replace a GUI after the original has been removed.
    if not gui or not gui.Parent or not main or not main.Parent then
        warn("[ErrorB1478Menu] Original GUI was deleted. Restart Play; pressing G never recreates it.")
        return
    end
    -- Already open? Snap home if an old drag/resize left it elsewhere.
    if visible == menuOpen then
        if visible and menuTween == nil then
            savedMenuPosition = UDim2.fromScale(0.5, 0.5)
            main.AnchorPoint = Vector2.new(0.5, 0.5)
            main.Position = savedMenuPosition
        end
        return
    end
    if not visible then
        if closeQuickSearch then closeQuickSearch() end
        if closeFpsPicker then closeFpsPicker() end
    end

    local wasMoving = menuTween ~= nil
    local token = stopMenuMotion() -- Ignore callbacks from cancelled moves.
    menuOpen = visible

    if visible then
        -- Every reopen targets the true screen centre, even after dragging
        -- or changing display size. Do not create any new GUI instances.
        main.AnchorPoint = Vector2.new(0.5, 0.5)
        savedMenuPosition = UDim2.fromScale(0.5, 0.5)
        -- Already parked off-screen on the left. Even when G interrupts the
        -- hidden journey, begin on the LEFT, never instantiate another GUI.
        main.Position = getMenuOffscreenLeftPosition()
        moveMenuTo(savedMenuPosition, menuSlideDuration,
            Enum.EasingDirection.Out, token)
    else
        -- Never reuse a dragged position as the next opening destination.
        savedMenuPosition = UDim2.fromScale(0.5, 0.5)
        local rightPosition = getMenuOffscreenRightPosition()
        local leftPosition = getMenuOffscreenLeftPosition()
        local bottomRight = getMenuOffscreenBottomPosition(rightPosition)
        local bottomLeft = getMenuOffscreenBottomPosition(leftPosition)

        -- Visible path: original location -> past the RIGHT edge.
        -- Hidden/off-screen path: go BELOW the viewport -> across to LEFT
        -- -> back up to off-screen LEFT, ready for the next G press.
        -- Nothing is hidden, disabled, destroyed or cloned.
        moveMenuTo(rightPosition, menuSlideDuration,
            Enum.EasingDirection.In, token, function()
                moveMenuTo(bottomRight, menuAroundDuration,
                    Enum.EasingDirection.InOut, token, function()
                        moveMenuTo(bottomLeft, menuAroundDuration,
                            Enum.EasingDirection.InOut, token, function()
                                moveMenuTo(leftPosition, menuAroundDuration,
                                    Enum.EasingDirection.InOut, token)
                            end)
                    end)
            end)
    end

    if floatingToggleButton and floatingToggleButton.Parent then
        floatingToggleButton.Visible = floatingToggleEnabled
    end

    -- Do not refresh the Finder on G: it would rebuild hundreds of buttons.
    -- The Finder's own Refresh button still works.
end

local inputConnection = trackServiceConnection(UserInputService.InputBegan:Connect(
    function(input, processed)
        if destroyed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if keyCaptureTarget then
            -- ESC cancels, BACKSPACE/DELETE clear the binding, and a normal
            -- keyboard key assigns it. Never assign Unknown as a shortcut.
            local target = keyCaptureTarget
            keyCaptureTarget = nil
            lastKeyCaptureAt = os.clock()
            if input.KeyCode == Enum.KeyCode.Escape then
                if keyCaptureStatusCallback then keyCaptureStatusCallback("Key change cancelled.") end
            elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
                if target == "menu" then menuToggleKey = nil
                elseif target == "fly" then flyToggleKey = nil
                elseif target == "noclip" then noclipToggleKey = nil
                elseif target == "jump" then jumpToggleKey = nil
                elseif target == "esp" then espToggleKey = nil
                elseif target == "position" then positionSaveKey = nil
                elseif target == "teleport" then teleportHoldKey = nil
                elseif target == "search" then commandSearchKey = nil
                elseif target == "destroy" then destroyAllKey = nil
                elseif target == "mouselock" then mouseLockKey = nil
                elseif target == "monochrome" then monochromeKey = nil end
                if keyCaptureStatusCallback then keyCaptureStatusCallback("Shortcut removed. You can still use the menu button.") end
            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                if target == "menu" then menuToggleKey = input.KeyCode
                elseif target == "fly" then flyToggleKey = input.KeyCode
                elseif target == "noclip" then noclipToggleKey = input.KeyCode
                elseif target == "jump" then jumpToggleKey = input.KeyCode
                elseif target == "esp" then espToggleKey = input.KeyCode
                elseif target == "position" then positionSaveKey = input.KeyCode
                elseif target == "teleport" then teleportHoldKey = input.KeyCode
                elseif target == "search" then commandSearchKey = input.KeyCode
                elseif target == "destroy" then destroyAllKey = input.KeyCode
                elseif target == "mouselock" then mouseLockKey = input.KeyCode
                elseif target == "monochrome" then monochromeKey = input.KeyCode end
                if keyCaptureStatusCallback then keyCaptureStatusCallback("Shortcut updated: " .. input.KeyCode.Name .. ".") end
            end
            if not menuToggleKey and not floatingToggleEnabled then
                floatingToggleEnabled = true
                if floatingToggleButton then floatingToggleButton.Visible = true end
            end
            if refreshOptionsLabels then refreshOptionsLabels() end
            return
        end
        if processed or os.clock() - lastKeyCaptureAt < 0.08 then return end

        -- Nil bindings are genuinely disabled. A shortcut that matches None
        -- cannot fire, and assigning None does not affect the GUI buttons.
        -- Explicitly assigned keys only. Destroy uses exactly the button's cleanup.
        if destroyAllKey and input.KeyCode == destroyAllKey then
            if destroyEverything then destroyEverything() end
            return
        elseif mouseLockKey and input.KeyCode == mouseLockKey then
            if toggleMouseLock then toggleMouseLock() end
            return
        elseif monochromeKey and input.KeyCode == monochromeKey then
            if toggleMonochromeHighlights then toggleMonochromeHighlights() end
            return
        elseif positionSaveKey and input.KeyCode == positionSaveKey then
            -- Keep the on-screen destination centred when reopening.
            savedMenuPosition = UDim2.fromScale(0.5, 0.5)
            print("[ErrorB1478Menu] Saved menu slide position: " .. tostring(savedMenuPosition) .. " (" .. positionSaveKey.Name .. ")")
            if positionSaveStatusCallback then pcall(positionSaveStatusCallback, positionSaveKey.Name) end
        elseif menuToggleKey and input.KeyCode == menuToggleKey then
            setMenuVisible(not menuOpen)
        elseif flyToggleKey and input.KeyCode == flyToggleKey then
            if flying then stopFly() else startFly() end
        elseif noclipToggleKey and input.KeyCode == noclipToggleKey then
            setNoclip(not noclip)
        elseif jumpToggleKey and input.KeyCode == jumpToggleKey then
            infiniteJump = not infiniteJump
            setInfiniteJumpButtonState()
        elseif espToggleKey and input.KeyCode == espToggleKey then
            setPlayerEspEnabled(not playerEspEnabled)
        end
    end
))

table.insert(connections, inputConnection)

--==================================================
-- HOLD-KEY + LEFT-CLICK TELEPORT (CLIENT, GAME WORLD ONLY)
--==================================================
-- Does not create a tool, RenderStepped loop, GUI, or extra menu instance.
-- Server-controlled anti-teleport or movement systems may override a
-- LocalScript's character movement in games that enforce server authority.
local lastClickTeleportAt = -math.huge
local activeWallRelease = nil
registerCleanup(function()
    if activeWallRelease then activeWallRelease() end
end)
local function pointWithinGui(guiObject, point)
    if not guiObject or not guiObject.Parent or not guiObject.Visible then return false end
    local topLeft = guiObject.AbsolutePosition
    local size = guiObject.AbsoluteSize
    return point.X >= topLeft.X and point.X <= topLeft.X + size.X
        and point.Y >= topLeft.Y and point.Y <= topLeft.Y + size.Y
end

trackServiceConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if destroyed or not teleportHoldKey or keyCaptureTarget or processed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if UserInputService:GetFocusedTextBox() then return end
    if not UserInputService:IsKeyDown(teleportHoldKey) then return end
    if os.clock() - lastClickTeleportAt < 0.2 then return end

    local pointer = UserInputService:GetMouseLocation()
    -- GUI uses IgnoreGuiInset=true, so its AbsolutePosition is screen-aligned.
    -- Never teleport when clicking any part of the menu/floating toggle.
    if (menuOpen and pointWithinGui(main, pointer))
        or pointWithinGui(floatingToggleButton, pointer) then
        return
    end
    local character = getCharacter()
    local root = getRoot()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local camera = workspace.CurrentCamera
    if not camera or not character or not root or not humanoid or humanoid.Health <= 0 then return end

    -- GetMouseLocation is viewport-based; ViewportPointToRay avoids the
    -- top-bar inset mismatch when ScreenGui.IgnoreGuiInset is true.
    local ray = camera:ViewportPointToRay(pointer.X, pointer.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = true
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 2048, params)
    if not hit then
        if teleportStatusCallback then teleportStatusCallback("No world surface under your cursor.") end
        return
    end
    -- Surface-aware positioning. The raycast hit is exactly the mouse's
    -- world point; place the character just OUTSIDE the surface, otherwise
    -- Roblox physics pushes the root back out of the wall immediately.
    lastClickTeleportAt = os.clock()
    local normal = hit.Normal
    local half = root.Size * 0.5
    local separation = math.abs(normal.X) * half.X
        + math.abs(normal.Y) * half.Y + math.abs(normal.Z) * half.Z + 0.05
    local landingPosition = hit.Position + normal * separation
    -- Release any previous wall cling before starting a new teleport.
    if activeWallRelease then activeWallRelease() end
    local ok, err = pcall(function()
        local originalRotation = root.CFrame.Rotation
        root.Anchored = false
        root.CFrame = CFrame.new(landingPosition) * originalRotation
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        -- Wall and ceiling: hold the clicked height until movement starts.
        if normal.Y < 0.6 then
            root.Anchored = true
            local thisRoot = root
            local released = false
            local releaseConnection
            local function release()
                if released then return end
                released = true
                if releaseConnection then releaseConnection:Disconnect() end
                if thisRoot.Parent then thisRoot.Anchored = false end
                if activeWallRelease == release then activeWallRelease = nil end
            end
            activeWallRelease = release
            releaseConnection = UserInputService.InputBegan:Connect(function(key, processedKey)
                if processedKey or key.UserInputType ~= Enum.UserInputType.Keyboard then return end
                local code = key.KeyCode
                if code == Enum.KeyCode.W or code == Enum.KeyCode.A or code == Enum.KeyCode.S
                    or code == Enum.KeyCode.D or code == Enum.KeyCode.Space then
                    release()
                end
            end)
            task.delay(10, release) -- Fail-safe: never trap a player indefinitely.
        end
    end)
    if not ok then
        warn("[ErrorB1478Menu][TELEPORT] " .. tostring(err))
        if teleportStatusCallback then teleportStatusCallback("Teleport failed; check the F9 console.") end
    else
        print("[ErrorB1478Menu][TELEPORT] Clicked " .. hit.Instance:GetFullName() .. " at " .. tostring(hit.Position))
        if teleportStatusCallback then
            teleportStatusCallback("Wall/object hit at " .. tostring(hit.Position) .. ". Move to release wall cling.")
        end
    end
end))

