--==================================================
-- UI UPGRADE PACK: MODERN DARK THEME + RESPONSIVE SCALE
-- Keep this section at the VERY END of the same LocalScript.
-- It styles the existing menu and any UI objects added later.
--==================================================

do
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local uiGui = gui
    local uiMain = main
    local uiTopBar = topBar
    local uiSidebar = sidebar
    local uiContent = content

    local UI = {
        background = Color3.fromRGB(13, 16, 24),
        panel = Color3.fromRGB(20, 25, 36),
        panelSoft = Color3.fromRGB(27, 34, 48),
        panelHover = Color3.fromRGB(38, 49, 68),
        accent = Color3.fromRGB(93, 132, 255),
        accentBright = Color3.fromRGB(121, 154, 255),
        text = Color3.fromRGB(239, 243, 255),
        muted = Color3.fromRGB(151, 163, 185),
        border = Color3.fromRGB(53, 66, 91),
        success = Color3.fromRGB(83, 210, 151),
    }

    local styled = setmetatable({}, { __mode = "k" })
    local hoverConnections = setmetatable({}, { __mode = "k" })

    local function addCorner(object, radius)
        if not object:FindFirstChildOfClass("UICorner") then
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, radius or 10)
            corner.Parent = object
        end
    end

    local function addStroke(object, color, transparency, thickness)
        local stroke = object:FindFirstChildOfClass("UIStroke")
        if not stroke then
            stroke = Instance.new("UIStroke")
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Parent = object
        end
        stroke.Color = color or UI.border
        stroke.Transparency = transparency == nil and 0.35 or transparency
        stroke.Thickness = thickness or 1
    end

    local function styleObject(object)
        if styled[object] then return end
        if not object:IsDescendantOf(uiGui) then return end
        styled[object] = true

        if object:IsA("TextLabel") then
            object.Font = object.TextSize >= 18 and Enum.Font.GothamBold or Enum.Font.Gotham
            if object.TextColor3 ~= UI.accent and object.TextColor3 ~= UI.success then
                object.TextColor3 = (object.TextSize <= 12) and UI.muted or UI.text
            end
            object.TextWrapped = object.TextWrapped or object.TextSize <= 13
            object.BackgroundTransparency = object.BackgroundTransparency

        elseif object:IsA("TextButton") then
            object.AutoButtonColor = false
            object.Font = Enum.Font.GothamSemibold
            object.TextColor3 = UI.text
            object.TextSize = math.clamp(object.TextSize, 12, 15)
            object.BorderSizePixel = 0
            if object.BackgroundTransparency >= 1 then
                object.BackgroundTransparency = 0
                object.BackgroundColor3 = UI.panelSoft
            elseif object.BackgroundColor3 == Color3.fromRGB(65, 105, 180) then
                object.BackgroundColor3 = UI.accent
            else
                object.BackgroundColor3 = UI.panelSoft
            end
            addCorner(object, 9)
            addStroke(object, UI.border, 0.55, 1)

            if not hoverConnections[object] then
                local baseColor = object.BackgroundColor3
                local hovering = false
                hoverConnections[object] = true
                object.MouseEnter:Connect(function()
                    hovering = true
                    TweenService:Create(object, TweenInfo.new(0.12), {
                        BackgroundColor3 = UI.panelHover
                    }):Play()
                end)
                object.MouseLeave:Connect(function()
                    hovering = false
                    local target = baseColor
                    if not object.Parent then return end
                    TweenService:Create(object, TweenInfo.new(0.14), {
                        BackgroundColor3 = target
                    }):Play()
                end)
                object.Activated:Connect(function()
                    if not object.Parent then return end
                    local oldSize = object.Size
                    TweenService:Create(object, TweenInfo.new(0.07), {
                        BackgroundColor3 = UI.accentBright
                    }):Play()
                    task.delay(0.09, function()
                        if object.Parent and not hovering then
                            TweenService:Create(object, TweenInfo.new(0.14), {
                                BackgroundColor3 = baseColor
                            }):Play()
                        end
                    end)
                end)
            end

        elseif object:IsA("TextBox") then
            object.Font = Enum.Font.Gotham
            object.TextColor3 = UI.text
            object.PlaceholderColor3 = UI.muted
            object.BackgroundColor3 = UI.background
            object.BorderSizePixel = 0
            object.ClearTextOnFocus = false
            addCorner(object, 9)
            addStroke(object, UI.border, 0.25, 1)

        elseif object:IsA("ScrollingFrame") then
            object.ScrollBarThickness = 5
            object.ScrollBarImageColor3 = UI.accent
            object.BackgroundColor3 = UI.background
            object.BorderSizePixel = 0
            object.ScrollingDirection = Enum.ScrollingDirection.Y

        elseif object:IsA("Frame") then
            object.BorderSizePixel = 0
            if object == uiMain then
                object.BackgroundColor3 = UI.background
                addCorner(object, 16)
                addStroke(object, UI.border, 0.15, 1.4)
            elseif object == uiTopBar then
                object.BackgroundColor3 = UI.panel
                addStroke(object, UI.border, 0.65, 1)
            elseif object == uiSidebar then
                object.BackgroundColor3 = UI.panel
            elseif object == uiContent then
                object.BackgroundColor3 = UI.background
            elseif object.BackgroundTransparency < 1 then
                -- Give existing cards/rows a consistent modern surface.
                object.BackgroundColor3 = UI.panel
                addCorner(object, 11)
                addStroke(object, UI.border, 0.68, 1)
            end

        elseif object:IsA("ImageButton") then
            object.AutoButtonColor = false
            addCorner(object, 10)
            addStroke(object, UI.border, 0.45, 1)
        end
    end

    -- Main window details.
    uiMain.ClipsDescendants = true
    if not uiMain:FindFirstChild("UIUpgradeScale") then
        local scale = Instance.new("UIScale")
        scale.Name = "UIUpgradeScale"
        scale.Scale = 1
        scale.Parent = uiMain

        local function resizeForScreen()
            local camera = workspace.CurrentCamera
            if not camera then return end
            local viewport = camera.ViewportSize
            local scaleFactor = math.min(viewport.X / 850, viewport.Y / 760, 1)
            scale.Scale = math.clamp(scaleFactor, 0.62, 1)
            uiMain.AnchorPoint = Vector2.new(0.5, 0.5)
            uiMain.Position = UDim2.fromScale(0.5, 0.5)
        end
        resizeForScreen()
        if workspace.CurrentCamera then
            workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resizeForScreen)
        end
    end

    -- Subtle blue accent line under the header.
    if not uiTopBar:FindFirstChild("UIUpgradeAccent") then
        local accentLine = Instance.new("Frame")
        accentLine.Name = "UIUpgradeAccent"
        accentLine.Size = UDim2.new(1, 0, 0, 2)
        accentLine.Position = UDim2.new(0, 0, 1, -2)
        accentLine.BackgroundColor3 = UI.accent
        accentLine.BorderSizePixel = 0
        accentLine.ZIndex = uiTopBar.ZIndex + 2
        accentLine.Parent = uiTopBar
        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, UI.accent),
            ColorSequenceKeypoint.new(0.5, UI.accentBright),
            ColorSequenceKeypoint.new(1, UI.accent),
        })
        gradient.Parent = accentLine
    end

    -- Style everything already created.
    for _, object in ipairs(uiGui:GetDescendants()) do
        styleObject(object)
    end

    -- Also style buttons/cards created later by waypoint, console, and options code.
    uiGui.DescendantAdded:Connect(function(object)
        task.defer(function()
            if object and object.Parent then
                styleObject(object)
            end
        end)
    end)

    -- Small accessibility polish.
    for _, object in ipairs(uiGui:GetDescendants()) do
        if object:IsA("TextButton") or object:IsA("TextBox") then
            object.Selectable = true
        end
    end

    print("UI Upgrade loaded: modern theme, hover effects, and responsive scaling enabled.")
end

