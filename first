    -- Wait for the character to load.
    local characterHumanoid =
        character:WaitForChild("Humanoid", 10)

    character:WaitForChild("HumanoidRootPart", 10)

    if destroyed or not characterHumanoid then
        return
    end

    humanoid = characterHumanoid
    rootPart = character:FindFirstChild("HumanoidRootPart")

    -- Remember the normal settings for the new character.
    originalWalkSpeed = characterHumanoid.WalkSpeed
    originalUseJumpPower = characterHumanoid.UseJumpPower
    originalJumpPower = characterHumanoid.JumpPower
    originalJumpHeight = characterHumanoid.JumpHeight

    -- Apply the user's saved movement values.
    characterHumanoid.WalkSpeed = savedWalkSpeed

    if characterHumanoid.UseJumpPower then
        characterHumanoid.JumpPower = savedJumpPower
    else
        characterHumanoid.JumpHeight = savedJumpHeight
    end

    -- Reset old flight objects before starting again.
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end

    flying = false

    if characterHumanoid then
        characterHumanoid.PlatformStand = false
    end

    updateMovementButton(flyButton, "Fly", false)

    -- Refresh ESP after the character loads.
