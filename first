-- TOOL TEXTURE
local function getToolTexture(tool)
    local texture = ""

    pcall(function()
        texture = tool.TextureId or ""
    end)

    if texture ~= "" then
        return texture
    end

    -- Some tools use a Handle with a SpecialMesh texture.
    local handle = tool:FindFirstChild("Handle")

    if handle then
        local mesh = handle:FindFirstChildWhichIsA("SpecialMesh")

        if mesh and mesh.TextureId ~= "" then
            return mesh.TextureId
        end

        local decal = handle:FindFirstChildWhichIsA("Decal")

        if decal and decal.Texture ~= "" then
            return decal.Texture
        end
    end

    return ""
end

-- GET EQUIPPED AND BACKPACK TOOLS
local function getPlayerTools(targetPlayer)
    local tools = {}
    local seen = {}

    local character = targetPlayer.Character
    local backpack = targetPlayer:FindFirstChildOfClass("Backpack")

    local function addTools(container, equipped)
        if not container then
            return
        end

        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and not seen[item] then
                seen[item] = true

                table.insert(tools, {
                    name = item.Name,
                    texture = getToolTexture(item),
                    equipped = equipped
                })
            end
        end
    end

    addTools(character, true)
    addTools(backpack, false)

    table.sort(tools, function(a, b)
        if a.equipped ~= b.equipped then
            return a.equipped
        end

        return string.lower(a.name) < string.lower(b.name)
    end)

    return tools
end

