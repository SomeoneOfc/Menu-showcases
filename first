		Objects.Container:GetChildren()
	) do

		Child:Destroy()

	end

	--========================================================
	-- DISPLAY NAME
	--========================================================

	local DisplayName = Instance.new("TextLabel")

	DisplayName.Size = UDim2.new(1, 0, 0, 24)

	DisplayName.BackgroundTransparency = 1

	DisplayName.Text = Player.DisplayName

	DisplayName.TextColor3 =
		Color3.fromRGB(255, 220, 80)

	DisplayName.TextStrokeTransparency = 0.2

	DisplayName.TextSize = 16

	DisplayName.Font =
		Enum.Font.GothamBold

	DisplayName.Parent = Objects.Container

	--========================================================
	-- USERNAME
	--========================================================

	local Username = Instance.new("TextLabel")

	Username.Size = UDim2.new(1, 0, 0, 20)

	Username.Position = UDim2.new(0, 0, 0, 23)

	Username.BackgroundTransparency = 1

	Username.Text = "@" .. Player.Name

	Username.TextColor3 =
		Color3.fromRGB(220, 220, 220)

	Username.TextStrokeTransparency = 0.2

	Username.TextSize = 13

	Username.Font =
		Enum.Font.Gotham

	Username.Parent = Objects.Container

	--========================================================
	-- TOOL AREA
	--========================================================

	local ToolArea = Instance.new("ScrollingFrame")

	ToolArea.Name = "Tools"

	ToolArea.Size = UDim2.new(1, 0, 0, 90)

	ToolArea.Position = UDim2.new(0, 0, 0, 45)

	ToolArea.BackgroundTransparency = 1

	ToolArea.BorderSizePixel = 0

	ToolArea.ScrollBarThickness = 3

	ToolArea.CanvasSize =
		UDim2.new(0, 0, 0, 0)

	ToolArea.Parent = Objects.Container

	local ToolLayout = Instance.new("UIListLayout")

	ToolLayout.FillDirection =
		Enum.FillDirection.Horizontal

	ToolLayout.HorizontalAlignment =
		Enum.HorizontalAlignment.Center

	ToolLayout.VerticalAlignment =
		Enum.VerticalAlignment.Top

	ToolLayout.Padding =
		UDim.new(0, 6)

	ToolLayout.Parent = ToolArea

	--========================================================
	-- ADD TOOLS
	--========================================================

	local Tools = GetTools(Player)

	for _, Tool in ipairs(Tools) do

		CreateToolDisplay(
			ToolArea,
			Tool.Name,
			Tool.Texture,
			Tool.Held
		)

	end

	--========================================================
	-- UPDATE SCROLL SIZE
	--========================================================

	task.defer(function()

		if ToolLayout.Parent then

			ToolArea.CanvasSize =
				UDim2.new(
					0,
					ToolLayout.AbsoluteContentSize.X + 10,
					0,
					0
				)

		end

	end)

end

--============================================================
-- CREATE ESP FOR PLAYER
--============================================================

local function CreateESP(Player)

	if Player == LocalPlayer then
		return
	end

	if PanicActivated then
		return
	end

	if PlayerObjects[Player] then
		return
	end

	PlayerObjects[Player] = {}

	--========================================================
	-- CHARACTER SETUP
	--========================================================

	local function SetupCharacter(Character)

		if PanicActivated then
			return
		end

		local Objects = PlayerObjects[Player]

		if not Objects then
			return
		end

		-- Remove old objects
		if Objects.Highlight then
			Objects.Highlight:Destroy()
		end

		if Objects.Billboard then
			Objects.Billboard:Destroy()
		end

		--====================================================
		-- OUTLINE
		--====================================================

		local Highlight = Instance.new("Highlight")

		Highlight.Name =
			"PlayerOutline"

		Highlight.Adornee =
			Character

		Highlight.FillColor =
			OUTLINE_COLOR

		Highlight.FillTransparency =
			0.9

		Highlight.OutlineColor =
			OUTLINE_COLOR

		Highlight.OutlineTransparency =
			0

		Highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		Highlight.Enabled =
			Enabled

		Highlight.Parent =
			Character

		Objects.Highlight =
			Highlight

		--====================================================
		-- FIND HEAD
		--====================================================

		local Head =
			Character:FindFirstChild("Head")

		if not Head then

			Head =
				Character:WaitForChild(
					"Head",
					5
				)

		end

		if not Head then
			return
		end

		--====================================================
		-- BILLBOARD
		--====================================================

		local Billboard =
			Instance.new("BillboardGui")

		Billboard.Name =
			"PlayerInformation"

		Billboard.Adornee =
			Head

		Billboard.Size =
			UDim2.new(0, 420, 0, 150)

		Billboard.StudsOffset =
			Vector3.new(0, 4.5, 0)

		Billboard.AlwaysOnTop =
			true

		Billboard.MaxDistance =
			MAX_DISTANCE

		Billboard.Enabled =
			Enabled

		Billboard.Parent =
			Head

		Objects.Billboard =
			Billboard

		--====================================================
		-- CONTAINER
		--====================================================

		local Container =
			Instance.new("Frame")

		Container.Size =
			UDim2.new(1, 0, 1, 0)

		Container.BackgroundTransparency =
			1

		Container.Parent =
			Billboard

		Objects.Container =
			Container

		-- Initial information
		UpdateBillboard(Player)

	end

	--========================================================
	-- CURRENT CHARACTER
	--========================================================

	if Player.Character then

		task.spawn(function()

			SetupCharacter(
				Player.Character
			)

		end)

	end

	--========================================================
	-- CHARACTER RESPAWN
	--========================================================

	Player.CharacterAdded:Connect(
		function(Character)

			if PanicActivated then
				return
			end

			task.wait(0.25)

			if PlayerObjects[Player] then

				SetupCharacter(Character)

			end

		end
	)

end

--============================================================
-- REMOVE ESP
--============================================================

local function RemoveESP(Player)

	local Objects =
		PlayerObjects[Player]

	if not Objects then
		return
	end

	if Objects.Highlight then
		Objects.Highlight:Destroy()
	end

	if Objects.Billboard then
		Objects.Billboard:Destroy()
	end

	PlayerObjects[Player] = nil

end

--============================================================
-- ENABLE / DISABLE
--============================================================

local function SetEnabled(State)

	if PanicActivated then
		return
	end

	Enabled = State

	for Player, Objects in pairs(PlayerObjects) do

		if Objects.Highlight then

			Objects.Highlight.Enabled =
				Enabled

		end

		if Objects.Billboard then

			Objects.Billboard.Enabled =
				Enabled

		end

	end

end

--============================================================
-- Y TOGGLE
--============================================================

UserInputService.InputBegan:Connect(
	function(Input, GameProcessed)

		if GameProcessed then
			return
		end

		if PanicActivated then
			return
		end

		if Input.KeyCode ==
			Enum.KeyCode.Y then

			SetEnabled(not Enabled)

		end

	end
)

--============================================================
-- INITIAL PLAYERS
--============================================================

for _, Player in ipairs(
	Players:GetPlayers()
) do

	CreateESP(Player)

end

--============================================================
-- PLAYER ADDED
--============================================================

Players.PlayerAdded:Connect(
	function(Player)

		if not PanicActivated then

			CreateESP(Player)

		end

	end
)

--============================================================
-- PLAYER REMOVING
--============================================================

Players.PlayerRemoving:Connect(
	function(Player)

		RemoveESP(Player)

	end
)

--============================================================
-- 1 SECOND SCAN
--============================================================
-- This is the important part.
--
-- Every second it checks the actual Players service
-- instead of relying only on PlayerAdded.
--
-- It also refreshes the inventory display for every
-- player, allowing newly replicated Tools to appear.
--============================================================

task.spawn(function()

	while not PanicActivated do

		task.wait(1)

		if PanicActivated then
			break
		end

		--====================================================
		-- CHECK FOR NEW PLAYERS
		--====================================================

		local CurrentPlayers = {}

		for _, Player in ipairs(
			Players:GetPlayers()
		) do

			CurrentPlayers[Player] = true

			if Player ~= LocalPlayer then

				if not PlayerObjects[Player] then

					CreateESP(Player)

				end

			end

		end

		--====================================================
		-- CHECK FOR PLAYERS THAT LEFT
		--====================================================

		for Player, Objects in pairs(
			PlayerObjects
		) do

			if not CurrentPlayers[Player] then

				RemoveESP(Player)

			end

		end

		--====================================================
		-- CHECK FOR NEW / REMOVED ITEMS
		--====================================================

		if Enabled then

			for Player, Objects in pairs(
				PlayerObjects
			) do

				if Player.Parent ==
					Players then

					if Player.Character then

						-- Make sure the outline still exists
						if not Objects.Highlight then

							CreateESP(Player)

						else

							Objects.Highlight.Adornee =
								Player.Character

						end

						-- Make sure the billboard still exists
						local Head =
							Player.Character:FindFirstChild(
								"Head"
							)

						if Head then

							if not Objects.Billboard then

								-- Recreate ESP if necessary
								CreateESP(Player)

							else

								-- Make sure billboard is attached
								Objects.Billboard.Adornee =
									Head

								-- Refresh ALL item information
								UpdateBillboard(Player)

							end

						end

					end

				end

			end

		end

	end

end)

