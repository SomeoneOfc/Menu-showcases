local function collectFolders(parent, path)
    if destroyed then
        return
    end

    for _, object in ipairs(parent:GetChildren()) do
        if destroyed then
            return
        end

        local objectPath =
            path .. "/" .. object.Name

        if object:IsA("Folder") then
            table.insert(allFolders, {
                Object = object,
                Path = objectPath
            })

            collectFolders(
                object,
                objectPath
            )
        end
    end
end

