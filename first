local function rebuildFolderList()
    if destroyed then
        return
    end

    clearFolderList()

    local query =
        string.lower(searchBox.Text)

    local visibleCount = 0

    for _, data in ipairs(allFolders) do
        local pathLower =
            string.lower(data.Path)

        if query == ""
            or string.find(
                pathLower,
                query,
                1,
                true
            )
        then
            createFolderButton(data)
            visibleCount += 1
        end
    end

    folderList.CanvasSize =
        UDim2.fromOffset(
            0,
            math.max(
                visibleCount * 37 + 10,
                270
            )
        )
end

