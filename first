local function findTeleportPart(folder)
    if not folder then
        return nil
    end

    if folder:IsA("BasePart") then
        return folder
    end

    local descendants =
        folder:GetDescendants()

    for _, object in ipairs(descendants) do
        if object:IsA("BasePart") then
            return object
        end
    end

    return nil
end

