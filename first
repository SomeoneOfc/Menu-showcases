        errorMonitorGui.Enabled = false
    end
end

local function recordClientError(message)
    __EB1478_errorCount += 1
    local line = "#" .. tostring(__EB1478_errorCount) .. ": " .. tostring(message or "Unknown client error")
    table.insert(__EB1478_errorLines, line)
    while #__EB1478_errorLines > 7 do table.remove(__EB1478_errorLines, 1) end
    warn("[ErrorB1478Menu][F9] Client error " .. line)
    if errorMonitorEnabled then
        buildErrorMonitor()
        if errorMonitorText then
            errorMonitorText.Text = table.concat(__EB1478_errorLines, "\n")
        end
    end
end

print("[ErrorB1478Menu][F9] Diagnostics active. Press F9 and select Client to view errors. Optional Error Monitor is OFF by default.")
LogService.MessageOut:Connect(function(message, messageType)
    if messageType == Enum.MessageType.MessageError then
        recordClientError(message)
    end
end)

-- ScriptContext provides the failing script and stack trace when available.
-- This is diagnostic only: it cannot resume a top-level script after a fatal error.
local __EB1478_scriptContextOk, __EB1478_scriptContext = pcall(function()
    return game:GetService("ScriptContext")
end)
if __EB1478_scriptContextOk and __EB1478_scriptContext then
    local __EB1478_connected, __EB1478_connectError = pcall(function()
        __EB1478_scriptContext.Error:Connect(function(message, stackTrace, sourceScript)
            local scriptName = (sourceScript and sourceScript.Name) or "unknown script"
            local key = tostring(message) .. "|" .. tostring(stackTrace)
            if __EB1478_seenErrors[key] then return end
            __EB1478_seenErrors[key] = true
            local report = "[ErrorB1478Menu][DIAGNOSTIC] Last startup section: " .. tostring(__EB1478_currentSection)
                .. " | Script: " .. scriptName .. " | Error: " .. tostring(message)
                .. " | Stack: " .. tostring(stackTrace)
            warn(report)
            __EB1478_failedSections[__EB1478_currentSection] = report
        end)
    end)
    if not __EB1478_connected then
        warn("[ErrorB1478Menu][DIAGNOSTIC] ScriptContext error listener unavailable: " .. tostring(__EB1478_connectError))
    end
else
    warn("[ErrorB1478Menu][DIAGNOSTIC] ScriptContext unavailable; use F9 Developer Console for errors.")
end

