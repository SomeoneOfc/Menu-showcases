local playerEspEnabled = false
local playerEspObjects = {}
local espRefreshElapsed = 0

local function getPlayerEspColor(targetPlayer)
    if targetPlayer.Team then
        return targetPlayer.Team.TeamColor.Color
    end
    return Color3.fromRGB(155, 155, 165)
end

local function removePlayerEsp(targetPlayer)
    local data = playerEspObjects[targetPlayer]
    if data then
        if data.highlight then
            data.highlight:Destroy()
        end
        if data.billboard then
            data.billboard:Destroy()
        end
        playerEspObjects[targetPlayer] = nil
    end
end

local function refreshPlayerEsp(targetPlayer)
    if not playerEspEnabled or not targetPlayer.Parent then
        removePlayerEsp(targetPlayer)
        return
    end

    local character = targetPlayer.Character
    if not character then
        removePlayerEsp(targetPlayer)
        return
    end

    local adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not adornee then
        return
    end

    local data = playerEspObjects[targetPlayer]
    if not data or data.character ~= character then
        removePlayerEsp(targetPlayer)
        data = { character = character }
        playerEspObjects[targetPlayer] = data

        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerTeamOutline"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.82
        highlight.OutlineTransparency = 0
        highlight.Adornee = character
        highlight.Parent = character
        data.highlight = highlight

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "PlayerToolList"
        billboard.Adornee = adornee
        billboard.Size = UDim2.fromOffset(300, 170)
        billboard.StudsOffset = Vector3.new(0, 4.0, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 500
        billboard.Parent = player:WaitForChild("PlayerGui")
        data.billboard = billboard

        local title = Instance.new("TextLabel")
        title.Name = "PlayerName"
        title.Size = UDim2.new(1, 0, 0, 26)
        title.Position = UDim2.fromOffset(0, 0)
        title.BackgroundTransparency = 1
        title.TextColor3 = Color3.new(1, 1, 1)
        title.TextStrokeTransparency = 0.25
        title.TextStrokeColor3 = Color3.new(0, 0, 0)
        title.TextSize = 14
        title.Font = Enum.Font.GothamBold
        title.Text = targetPlayer.DisplayName
        title.Parent = billboard
        data.title = title

        local list = Instance.new("ScrollingFrame")
        list.Name = "ToolInventory"
        list.Position = UDim2.fromOffset(0, 27)
        list.Size = UDim2.new(1, 0, 1, -27)
        list.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        list.BackgroundTransparency = 0.25
        list.BorderSizePixel = 0
        list.ScrollBarThickness = 4
        list.CanvasSize = UDim2.new(0, 0, 0, 0)
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.ScrollingDirection = Enum.ScrollingDirection.Y
        list.Parent = billboard
        data.list = list

        local listLayout = Instance.new("UIListLayout")
        listLayout.Padding = UDim.new(0, 3)
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Parent = list
        data.listLayout = listLayout
    end

    local color = getPlayerEspColor(targetPlayer)
    data.highlight.OutlineColor = color
    data.highlight.FillColor = color
    data.highlight.Adornee = character
    data.billboard.Adornee = adornee

    -- Show each Tool's inventory icon (Tool.TextureId) beside its name.
    -- [E] means equipped; [I] means stored in the Backpack.
    data.title.Text = targetPlayer.DisplayName .. "  |  Tools"
    local toolItems = {}
    local seenTools = {}

    local function addTools(container, equipped)
        if not container then
            return
        end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and not seenTools[item] then
                seenTools[item] = true
                table.insert(toolItems, {
                    tool = item,
                    equipped = equipped,
                    name = item.Name,
                    texture = item.TextureId or ""
                })
            end
        end
    end

    addTools(character, true)
    addTools(targetPlayer:FindFirstChildOfClass("Backpack"), false)

    local signatureParts = {}
    for _, entry in ipairs(toolItems) do
        table.insert(signatureParts, (entry.equipped and "E" or "I") .. ":" .. entry.name .. ":" .. entry.texture)
    end
    local signature = table.concat(signatureParts, "|")

    -- Rebuild rows only when the inventory changes, not on every refresh tick.
    if data.toolSignature ~= signature then
        data.toolSignature = signature
        for _, child in ipairs(data.list:GetChildren()) do
            if child ~= data.listLayout then
                child:Destroy()
            end
        end

        if #toolItems == 0 then
            local emptyLabel = Instance.new("TextLabel")
            emptyLabel.Name = "NoTools"
            emptyLabel.Size = UDim2.new(1, -8, 0, 25)
            emptyLabel.BackgroundTransparency = 1
            emptyLabel.Text = "No tools"
            emptyLabel.TextColor3 = Color3.new(1, 1, 1)
            emptyLabel.TextSize = 12
            emptyLabel.Font = Enum.Font.Gotham
            emptyLabel.Parent = data.list
        else
            for index, entry in ipairs(toolItems) do
                local row = Instance.new("Frame")
                row.Name = "ToolRow"
                row.LayoutOrder = index
                row.Size = UDim2.new(1, -6, 0, 30)
                row.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
                row.BackgroundTransparency = 0.2
                row.BorderSizePixel = 0
                row.Parent = data.list

                local icon = Instance.new("ImageLabel")
                icon.Name = "ToolIcon"
                icon.Position = UDim2.fromOffset(3, 3)
                icon.Size = UDim2.fromOffset(24, 24)
                icon.BackgroundColor3 = Color3.fromRGB(65, 65, 75)
                icon.BackgroundTransparency = 0.15
                icon.BorderSizePixel = 0
                icon.ScaleType = Enum.ScaleType.Fit
                icon.Image = entry.texture
                icon.Parent = row

                local toolLabel = Instance.new("TextLabel")
                toolLabel.Name = "ToolName"
                toolLabel.Position = UDim2.fromOffset(32, 0)
                toolLabel.Size = UDim2.new(1, -36, 1, 0)
                toolLabel.BackgroundTransparency = 1
                toolLabel.Text = (entry.equipped and "[E] " or "[I] ") .. entry.name
                toolLabel.TextColor3 = Color3.new(1, 1, 1)
                toolLabel.TextStrokeTransparency = 0.5
                toolLabel.TextSize = 12
                toolLabel.Font = Enum.Font.GothamBold
                toolLabel.TextXAlignment = Enum.TextXAlignment.Left
                toolLabel.TextTruncate = Enum.TextTruncate.AtEnd
                toolLabel.Parent = row
            end
        end
    end
end

local function setPlayerEspEnabled(enabled)
    playerEspEnabled = enabled
    if not enabled then
        for targetPlayer in pairs(playerEspObjects) do
            removePlayerEsp(targetPlayer)
        end
    else
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            refreshPlayerEsp(targetPlayer)
        end
    end
end

