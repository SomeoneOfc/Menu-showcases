            tp.Activated:Connect(function()
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = CFrame.new(data.position + Vector3.new(0, 3, 0))
                    waypointStatus.Text = "Teleported to " .. data.name
                    waypointStatus.TextColor3 = C.green
                else
                    waypointStatus.Text = "Your character is not ready."
                    waypointStatus.TextColor3 = C.red
                end
            end)
            local del = makeButton(row, "Delete", "DELETE", UDim2.new(1, -82, 0, 9), UDim2.fromOffset(70, 36), false)
            del.Activated:Connect(function()
                table.remove(waypoints, index)
                refreshWaypoints()
            end)
        end
        if #waypoints == 0 then
            waypointStatus.Text = "No waypoints saved yet."
            waypointStatus.TextColor3 = C.muted
        else
            waypointStatus.Text = #waypoints .. " waypoint(s) saved this session."
            waypointStatus.TextColor3 = C.muted
        end
    end
    createWaypoint.Activated:Connect(function()
        if #waypoints >= 100 then
            waypointStatus.Text = "Maximum of 100 waypoints reached."
            waypointStatus.TextColor3 = C.red
            return
        end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then
            waypointStatus.Text = "Your character is not ready."
            waypointStatus.TextColor3 = C.red
            return
        end
        local name = waypointName.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then name = "Waypoint " .. (#waypoints + 1) end
        for _, data in ipairs(waypoints) do
            if string.lower(data.name) == string.lower(name) then
                waypointStatus.Text = "That waypoint name is already in use."
                waypointStatus.TextColor3 = C.red
                return
            end
        end
        table.insert(waypoints, {name = name, position = root.Position})
        waypointName.Text = ""
        refreshWaypoints()
    end)

    -- CONSOLE PAGE. Client-side only: server Output/errors are not available here.
    makeHeader(consolePage, "Console", "Live client output captured from when this page loads onward.")
    local consoleStatus = makeLabel(consolePage, "ConsoleStatus", "Listening for client messages…", UDim2.fromOffset(22, 103), UDim2.new(1, -44, 0, 23), 11, C.muted, false)
    local consoleList = Instance.new("ScrollingFrame")
    consoleList.Name = "ConsoleLogList"
    consoleList.Position = UDim2.fromOffset(20, 132)
    consoleList.Size = UDim2.new(1, -40, 1, -188)
    consoleList.BackgroundColor3 = C.background
    consoleList.BorderSizePixel = 0
    consoleList.ScrollBarThickness = 5
    consoleList.ScrollBarImageColor3 = C.accent
    consoleList.CanvasSize = UDim2.fromOffset(0, 0)
    consoleList.Parent = consolePage
    addCorner(consoleList, 10)
    addOutline(consoleList, C.border, 0.45)
    local consoleLayout = Instance.new("UIListLayout")
    consoleLayout.Padding = UDim.new(0, 4)
    consoleLayout.SortOrder = Enum.SortOrder.LayoutOrder
    consoleLayout.Parent = consoleList
    local consolePadding = Instance.new("UIPadding")
    consolePadding.PaddingTop = UDim.new(0, 7)
    consolePadding.PaddingLeft = UDim.new(0, 7)
    consolePadding.PaddingRight = UDim.new(0, 7)
    consolePadding.Parent = consoleList
    local logCount = 0
    local function addLog(message, kind)
        if destroyed or not consoleList.Parent then return end
        logCount += 1
        local row = Instance.new("Frame")
        row.Name = "LogRow"
        row.Size = UDim2.new(1, -2, 0, 35)
        row.BackgroundColor3 = C.panel
        row.BorderSizePixel = 0
        row.LayoutOrder = logCount
        row.Parent = consoleList
        addCorner(row, 7)
        local logColor = kind == "ERROR" and C.red or (kind == "WARNING" and C.yellow or (kind == "SUCCESS" and C.green or C.muted))
        makeLabel(row, "Level", "[" .. (kind or "INFO") .. "]", UDim2.fromOffset(8, 0), UDim2.fromOffset(78, 35), 9, logColor, true)
        local messageLabel = makeLabel(row, "Message", tostring(message), UDim2.fromOffset(87, 0), UDim2.new(1, -94, 1, 0), 10, C.text, false)
        messageLabel.TextTruncate = Enum.TextTruncate.AtEnd
        if logCount > 200 then
            local oldest
            for _, child in ipairs(consoleList:GetChildren()) do
                if child.Name == "LogRow" and (not oldest or child.LayoutOrder < oldest.LayoutOrder) then oldest = child end
            end
            if oldest then oldest:Destroy() end
        end
        consoleStatus.Text = logCount .. " client message(s) captured"
        task.defer(function()
            if consoleList.Parent then
                consoleList.CanvasSize = UDim2.fromOffset(0, consoleLayout.AbsoluteContentSize.Y + 16)
                consoleList.CanvasPosition = Vector2.new(0, math.max(0, consoleLayout.AbsoluteContentSize.Y - consoleList.AbsoluteWindowSize.Y + 16))
            end
        end)
    end
    local clearConsole = makeButton(consolePage, "ClearConsole", "CLEAR LOG", UDim2.new(1, -140, 1, -46), UDim2.fromOffset(120, 34), false)
    clearConsole.Activated:Connect(function()
        for _, child in ipairs(consoleList:GetChildren()) do
            if child.Name == "LogRow" then child:Destroy() end
        end
        logCount = 0
        consoleStatus.Text = "Console cleared."
    end)
    LogService.MessageOut:Connect(function(message, messageType)
        if messageType == Enum.MessageType.MessageError then
            addLog(message, "ERROR")
        elseif messageType == Enum.MessageType.MessageWarning then
            addLog(message, "WARNING")
        else
            addLog(message, "INFO")
        end
    end)
    addLog("Menu UI and extra pages loaded.", "SUCCESS")

    -- BSS PAGE: list BaseParts and Models under workspace.HiddenStickers.
    makeHeader(bssPage, "BSS • HiddenStickers", "Browse objects in workspace.HiddenStickers and teleport to them.")
    local bssStatus = makeLabel(bssPage, "BSSStatus", "Checking workspace.HiddenStickers…", UDim2.fromOffset(22, 104), UDim2.new(1, -235, 0, 34), 11, C.muted, false)
    local refreshBSS = makeButton(bssPage, "RefreshBSS", "↻  REFRESH", UDim2.new(1, -145, 0, 103), UDim2.fromOffset(123, 36), true)
    local bssList = Instance.new("ScrollingFrame")
    bssList.Name = "HiddenStickersList"
    bssList.Position = UDim2.fromOffset(20, 148)
    bssList.Size = UDim2.new(1, -40, 1, -168)
    bssList.BackgroundColor3 = C.background
    bssList.BorderSizePixel = 0
    bssList.ScrollBarThickness = 5
    bssList.ScrollBarImageColor3 = C.accent
    bssList.CanvasSize = UDim2.fromOffset(0, 0)
    bssList.Parent = bssPage
    addCorner(bssList, 10)
    addOutline(bssList, C.border, 0.45)
    local bssLayout = Instance.new("UIListLayout")
    bssLayout.Padding = UDim.new(0, 7)
    bssLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bssLayout.Parent = bssList
    local bssPadding = Instance.new("UIPadding")
    bssPadding.PaddingTop = UDim.new(0, 8)
    bssPadding.PaddingLeft = UDim.new(0, 8)
    bssPadding.PaddingRight = UDim.new(0, 8)
    bssPadding.Parent = bssList
    bssLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        bssList.CanvasSize = UDim2.fromOffset(0, bssLayout.AbsoluteContentSize.Y + 16)
    end)

    local function getTargetPart(object)
        if object:IsA("BasePart") then return object end
        if object:IsA("Model") then
            if object.PrimaryPart then return object.PrimaryPart end
            return object:FindFirstChildWhichIsA("BasePart", true)
        end
        return object:FindFirstChildWhichIsA("BasePart", true)
    end

    local function refreshBSSObjects()
        for _, child in ipairs(bssList:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end
        local folder = workspace:FindFirstChild("HiddenStickers")
        if not folder then
            bssStatus.Text = "Folder not found. Expected workspace.HiddenStickers."
            bssStatus.TextColor3 = C.red
            return
        end
        local objects = {}
        for _, object in ipairs(folder:GetDescendants()) do
            if object:IsA("BasePart") or object:IsA("Model") then
                local part = getTargetPart(object)
                if part then table.insert(objects, {object = object, part = part}) end
            end
        end
        table.sort(objects, function(a, b) return a.object:GetFullName() < b.object:GetFullName() end)
        for index, entry in ipairs(objects) do
            local object = entry.object
            local row = Instance.new("Frame")
            row.Name = "BSSObjectRow"
            row.Size = UDim2.new(1, -2, 0, 50)
            row.BackgroundColor3 = C.panel
            row.BorderSizePixel = 0
            row.LayoutOrder = index
            row.Parent = bssList
            addCorner(row, 9)
            addOutline(row, C.border, 0.6)
            local displayName = object.Name
            if #displayName > 28 then displayName = string.sub(displayName, 1, 25) .. "..." end
            makeLabel(row, "ObjectName", displayName, UDim2.fromOffset(11, 4), UDim2.new(1, -135, 0, 22), 12, C.text, true)
            makeLabel(row, "ObjectType", object.ClassName .. "  •  " .. object:GetFullName(), UDim2.fromOffset(11, 27), UDim2.new(1, -135, 0, 16), 9, C.muted, false)
            local teleport = makeButton(row, "TeleportToObject", "TELEPORT", UDim2.new(1, -108, 0, 7), UDim2.fromOffset(96, 36), true)
            teleport.Activated:Connect(function()
                local livePart = object.Parent and getTargetPart(object)
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if not livePart then
                    bssStatus.Text = "Object no longer exists or has no BasePart."
                    bssStatus.TextColor3 = C.red
                    return
                end
                if not root then
                    bssStatus.Text = "Your character is not ready."
                    bssStatus.TextColor3 = C.red
                    return
                end
                root.CFrame = livePart.CFrame + Vector3.new(0, 4, 0)
                bssStatus.Text = "Teleported to " .. object.Name
                bssStatus.TextColor3 = C.green
            end)
        end
        bssStatus.Text = #objects .. " teleportable object(s) found in HiddenStickers."
        bssStatus.TextColor3 = #objects > 0 and C.green or C.yellow
    end
    refreshBSS.Activated:Connect(refreshBSSObjects)
    refreshBSSObjects()

    -- Finish the shared window styling and keep all tabs/pages in the same theme.
    main.BackgroundColor3 = C.background
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    addCorner(main, 15)
    addOutline(main, C.border, 0.18)
    topBar.BackgroundColor3 = C.panel
    sidebar.BackgroundColor3 = Color3.fromRGB(17, 22, 33)
    content.BackgroundColor3 = C.background
    sidebarTitle.TextColor3 = C.muted
    sidebarTitle.Text = "MENU PAGES"
    sidebarTitle.Font = Enum.Font.GothamBold
    sidebarTitle.TextSize = 10

    -- Responsive scale for the complete menu.
    if not main:FindFirstChild("PremiumMenuScale") then
        local scale = Instance.new("UIScale")
        scale.Name = "PremiumMenuScale"
        scale.Parent = main
        local function resizeMenu()
            local camera = workspace.CurrentCamera
            if not camera then return end
            local viewport = camera.ViewportSize
            scale.Scale = math.clamp(math.min(viewport.X / 850, viewport.Y / 760, 1), 0.62, 1)
            main.AnchorPoint = Vector2.new(0.5, 0.5)
            main.Position = UDim2.fromScale(0.5, 0.5)
        end
        resizeMenu()
        if workspace.CurrentCamera then
            workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resizeMenu)
        end
    end

    showPage(homePage)
    print("Premium UI loaded. Added Waypoints, Console, Options/keybinds, floating UI toggle, and BSS HiddenStickers teleports.")
end
