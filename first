local function performSearch()
    if destroyed then
        return
    end

    clearFinderResults()
    finderStatus.Text = "Searching..."

    local query = searchBox.Text
    local results = findObjects(query)

    resultsLabel.Text = "Results: " .. tostring(#results)

    if #results == 0 then
        finderStatus.Text = "No matching objects found."
        return
    end

    for index, object in ipairs(results) do
        createResultRow(object, index)
    end

    if #results >= 100 then
        finderStatus.Text = "Showing the first 100 matching objects."
    else
        finderStatus.Text = "Search complete."
    end
