-- FLY
local flyButton = createMovementButton("Fly: OFF", 20, 250, 210)

local function stopFlying()
    flying = false

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end

    local characterHumanoid = getHumanoid()

    if characterHumanoid then
        characterHumanoid.PlatformStand = false
    end

    updateMovementButton(flyButton, "Fly", false)
end

local function startFlying()
    local characterRoot = getRoot()
    local characterHumanoid = getHumanoid()

    if not characterRoot or not characterHumanoid then
        return
    end

    stopFlying()

    characterRoot = getRoot()
    characterHumanoid = getHumanoid()

    if not characterRoot or not characterHumanoid then
        return
    end

    flying = true
    characterHumanoid.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "MenuFlyVelocity"
    bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = characterRoot

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "MenuFlyGyro"
    bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bodyGyro.P = 10000
    bodyGyro.CFrame = characterRoot.CFrame
    bodyGyro.Parent = characterRoot

    updateMovementButton(flyButton, "Fly", true)
end

flyButton.MouseButton1Click:Connect(function()
    if flying then
        stopFlying()
    else
        startFlying()
    end
end)

